{
  "name": "triplenerdscore/applied-epic-rest-php",
  "description": "Typed PHP client for the modern Applied API (api.myappliedproducts.com)",
  "type": "library",
  "license": "MIT",
  "version": "2.0.0",
  "keywords": ["applied", "applied epic", "applied systems", "insurance", "api-client"],
  "authors": [
    {
      "name": "tripleNERDscore",
      "email": "hello@triplenerdscore.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^2.0 || ^3.0",
    "php-http/discovery": "^1.19",
    "guzzlehttp/guzzle": "^7.9",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5"
  },
  "autoload": {
    "psr-4": {
      "Tns\\Epic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tns\\Epic\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
