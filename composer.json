{
  "name": "triplenerdscore/applied-epic-rest-php",
  "description": "Typed PHP client for the Applied Epic SDK REST API",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "tripleNERDscore",
      "email": "hello@triplenerdscore.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0",
    "guzzlehttp/guzzle": "^7.9 || ^8.0",
    "php-http/discovery": "^1.19",
    "nyholm/psr7": "^1.8"
  },
  "autoload": {
    "psr-4": {
      "Tns\\Epic\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tns\\Epic\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}